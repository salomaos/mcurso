# Copie para .env e ajuste. (mcurso é single-user: o login valida APP_MASTER_PASSWORD)

# Segredo das sessões do Better Auth (gere com: pnpm exec auth secret ou openssl rand -hex 32)
BETTER_AUTH_SECRET=

# URL base do app (onde você acessa o sistema)
BETTER_AUTH_URL=http://localhost:5173

# Identidade do único usuário professor (fixa; só a senha é digitada no login)
APP_MASTER_EMAIL=professor@mcurso.local

# Senha mestra. O usuário é criado automaticamente no primeiro login.
# ATENÇÃO: mudar depois = resetar o usuário no banco (a senha armazenada é o hash scrypt antigo).
APP_MASTER_PASSWORD=

# Banco: `sqlite` (padrão, em arquivo) ou `mysql` (MySQL/MariaDB).
DB_DIALECT=sqlite

# Caminho do SQLite (relativo à raiz do projeto). Usado quando DB_DIALECT=sqlite.
DB_PATH=data/mcurso.db

# Conexão MySQL/MariaDB. Usada quando DB_DIALECT=mysql.
# O app cria as tabelas no boot (não precisa rodar migration na mão).
# DB_URL=mysql://usuario:senha@localhost:3306/mcurso

# Pasta de uploads (relativa à raiz do projeto)
UPLOADS_DIR=data/uploads